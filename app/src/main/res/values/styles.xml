<?xml version="1.0" encoding="utf-8"?>
<!--
    Yeniden kullanılabilir bileşen stilleri.
    iOS `UIView+Styling.swift` içindeki `applyPrimaryButtonStyle`, `applyOutlineButtonStyle`,
    `applyFormStyle`, `applyCardStyle` yardımcılarının karşılığı.

    Önemli: iOS kartlarda GÖLGE KULLANMIYOR — düşük kontrastlı 1dp kenarlık tercih ediyor.
    Aynı görsel dili korumak için Material kartlarda da elevation 0 + strokeWidth 1.
-->
<resources>

    <!-- region Tipografi -->
    <style name="TextAppearance.Kumbaram.LargeTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_large_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_text</item>
    </style>

    <style name="TextAppearance.Kumbaram.Title1" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_title1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_text</item>
    </style>

    <style name="TextAppearance.Kumbaram.Title2" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_text</item>
    </style>

    <style name="TextAppearance.Kumbaram.Title3" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title3</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_text</item>
    </style>

    <style name="TextAppearance.Kumbaram.Headline" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_text</item>
    </style>

    <style name="TextAppearance.Kumbaram.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/primary_text</item>
    </style>

    <style name="TextAppearance.Kumbaram.Callout" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_callout</item>
        <item name="android:textColor">@color/primary_text</item>
    </style>

    <style name="TextAppearance.Kumbaram.Subheadline" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_subheadline</item>
        <item name="android:textColor">@color/secondary_text</item>
    </style>

    <style name="TextAppearance.Kumbaram.Footnote" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_footnote</item>
        <item name="android:textColor">@color/secondary_text</item>
    </style>

    <style name="TextAppearance.Kumbaram.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/secondary_text</item>
    </style>

    <style name="TextAppearance.Kumbaram.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Sayısal metrikler: monospace rakam ile hizalı dursun (iOS monospacedDigit karşılığı) -->
    <style name="TextAppearance.Kumbaram.MetricValue" parent="TextAppearance.Kumbaram.Title2">
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.Kumbaram.MetricValueLarge" parent="TextAppearance.Kumbaram.Title1">
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.Kumbaram.MetricValueSmall" parent="TextAppearance.Kumbaram.Headline">
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <!-- endregion -->

    <!-- region Etiket / metin widget'ları -->
    <style name="Widget.Kumbaram.Text.SectionHeader" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Kumbaram.Footnote</item>
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
    <!-- endregion -->

    <!-- region Butonlar -->
    <style name="Widget.Kumbaram.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Kumbaram.Button</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/inverse_text</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="elevation">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/primary_subtle</item>
    </style>

    <style name="Widget.Kumbaram.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Kumbaram.Button</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">@dimen/hairline</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Kumbaram.Button.Secondary" parent="Widget.Kumbaram.Button">
        <item name="backgroundTint">@color/secondary_background</item>
        <item name="android:textColor">@color/primary_text</item>
    </style>

    <style name="Widget.Kumbaram.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.Kumbaram.Button</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
    </style>

    <style name="Widget.Kumbaram.Button.Text.Destructive" parent="Widget.Kumbaram.Button.Text">
        <item name="android:textColor">@color/error</item>
    </style>

    <!-- Küçük satır içi aksiyonlar (ör. "Kopyala") -->
    <style name="Widget.Kumbaram.Button.Compact" parent="Widget.Kumbaram.Button.Outline">
        <item name="android:minHeight">@dimen/compact_button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Kumbaram.Footnote</item>
    </style>

    <style name="Widget.Kumbaram.Button.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- endregion -->

    <!-- region Form alanları -->
    <style name="Widget.Kumbaram.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeWidth">@dimen/hairline</item>
        <item name="boxStrokeWidthFocused">@dimen/hairline</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="boxBackgroundColor">@color/elevated_surface</item>
        <item name="hintTextColor">@color/secondary_text</item>
        <item name="android:textColorHint">@color/tertiary_text</item>
        <item name="errorTextColor">@color/error</item>
        <item name="errorIconTint">@color/error</item>
    </style>

    <style name="Widget.Kumbaram.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textAppearance">@style/TextAppearance.Kumbaram.Body</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:textColor">@color/primary_text</item>
    </style>
    <!-- endregion -->

    <!-- region Kartlar -->
    <!-- iOS: gölge yok, 1dp düşük kontrastlı kenarlık. -->
    <style name="Widget.Kumbaram.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">@dimen/hairline</item>
    </style>

    <style name="Widget.Kumbaram.Card.Clickable" parent="Widget.Kumbaram.Card">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="rippleColor">@color/primary_subtle</item>
    </style>
    <!-- endregion -->

    <!-- region Diğer -->
    <style name="Widget.Kumbaram.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/screen_background</item>
        <item name="titleTextColor">@color/primary_text</item>
        <item name="titleTextAppearance">@style/TextAppearance.Kumbaram.Headline</item>
        <item name="navigationIconTint">@color/primary</item>
    </style>

    <style name="Widget.Kumbaram.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/screen_background</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Kumbaram.Caption</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Kumbaram.Caption</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Kumbaram.ProgressIndicator" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/primary</item>
    </style>

    <!-- Puan rozeti -->
    <style name="Widget.Kumbaram.PointsBadge" parent="Widget.AppCompat.TextView">
        <item name="android:background">@drawable/bg_points_badge</item>
        <item name="android:textAppearance">@style/TextAppearance.Kumbaram.Footnote</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:paddingEnd">@dimen/space_xs</item>
        <item name="android:paddingTop">@dimen/space_xxs</item>
        <item name="android:paddingBottom">@dimen/space_xxs</item>
    </style>
    <!-- endregion -->
</resources>
