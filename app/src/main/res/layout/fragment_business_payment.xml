<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Kumbaram.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/subscription_title" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:id="@+id/statusTitleTextView"
                    style="@style/TextAppearance.Kumbaram.Title2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/subscription_expired_title" />

                <TextView
                    android:id="@+id/statusMessageTextView"
                    style="@style/TextAppearance.Kumbaram.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/subscription_expired_message"
                    android:textColor="@color/secondary_text" />

                <TextView
                    android:id="@+id/remainingDaysTextView"
                    style="@style/TextAppearance.Kumbaram.MetricValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    tools:text="12 gün kaldı" />

                <TextView
                    android:id="@+id/expiryDateTextView"
                    style="@style/TextAppearance.Kumbaram.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    tools:text="Bitiş tarihi: 12 Eylül 2026" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Kumbaram.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <TextView
                            style="@style/Widget.Kumbaram.Text.SectionHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_label_phone" />

                        <TextView
                            android:id="@+id/phoneTextView"
                            style="@style/TextAppearance.Kumbaram.Headline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            tools:text="0552 554 50 09" />

                        <TextView
                            style="@style/Widget.Kumbaram.Text.SectionHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="@string/payment_label_price" />

                        <TextView
                            android:id="@+id/priceTextView"
                            style="@style/TextAppearance.Kumbaram.Headline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            tools:text="499 TL" />

                        <TextView
                            style="@style/Widget.Kumbaram.Text.SectionHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="@string/payment_label_description" />

                        <TextView
                            android:id="@+id/descriptionTextView"
                            style="@style/TextAppearance.Kumbaram.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/payment_contact_description"
                            android:textColor="@color/secondary_text" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/whatsappButton"
                    style="@style/Widget.Kumbaram.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/payment_whatsapp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkStatusButton"
                    style="@style/Widget.Kumbaram.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/payment_check_status" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signOutButton"
                    style="@style/Widget.Kumbaram.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/sign_out"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include
        android:id="@+id/loadingOverlay"
        layout="@layout/view_loading_overlay"
        android:visibility="gone" />
</FrameLayout>
