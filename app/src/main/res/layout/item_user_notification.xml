<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Kumbaram.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_md"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_md">

        <ImageView
            android:id="@+id/logoImageView"
            android:layout_width="@dimen/avatar"
            android:layout_height="@dimen/avatar"
            android:background="@drawable/bg_image_placeholder"
            android:contentDescription="@string/cd_business_logo"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleTextView"
                style="@style/TextAppearance.Kumbaram.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Çift puan" />

            <TextView
                android:id="@+id/bodyTextView"
                style="@style/TextAppearance.Kumbaram.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textColor="@color/secondary_text"
                tools:text="Bu hafta sonu çift puan" />

            <TextView
                android:id="@+id/detailTextView"
                style="@style/TextAppearance.Kumbaram.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                tools:text="KAFE • 12 Eyl 2026 14:30" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
