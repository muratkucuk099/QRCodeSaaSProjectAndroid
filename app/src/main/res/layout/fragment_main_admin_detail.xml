<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Kumbaram.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/ic_arrow_back"
            tools:title="KAFE ADI" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <ImageView
                    android:id="@+id/logoImageView"
                    android:layout_width="@dimen/profile_avatar"
                    android:layout_height="@dimen/profile_avatar"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_image_placeholder"
                    android:contentDescription="@string/cd_business_logo"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/nameTextView"
                    style="@style/TextAppearance.Kumbaram.Title2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center"
                    tools:text="KAFE ADI" />

                <TextView
                    android:id="@+id/emailTextView"
                    style="@style/TextAppearance.Kumbaram.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:textColor="@color/secondary_text"
                    tools:text="kafe@mail.com" />

                <TextView
                    android:id="@+id/phoneTextView"
                    style="@style/TextAppearance.Kumbaram.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/secondary_text"
                    tools:text="0552 554 50 09" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Kumbaram.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <TextView
                            android:id="@+id/statusTextView"
                            style="@style/TextAppearance.Kumbaram.Headline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Aktif abonelik" />

                        <TextView
                            android:id="@+id/remainingTextView"
                            style="@style/TextAppearance.Kumbaram.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            tools:text="12 gün kaldı" />

                        <TextView
                            android:id="@+id/expiryTextView"
                            style="@style/TextAppearance.Kumbaram.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            tools:text="Bitiş tarihi: 12 Eylül 2026" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/extendButton"
                    style="@style/Widget.Kumbaram.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/main_admin_extend" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shortenButton"
                    style="@style/Widget.Kumbaram.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/main_admin_shorten" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelButton"
                    style="@style/Widget.Kumbaram.Button.Text.Destructive"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/main_admin_cancel_subscription" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include
        android:id="@+id/loadingOverlay"
        layout="@layout/view_loading_overlay"
        android:visibility="gone" />
</FrameLayout>
