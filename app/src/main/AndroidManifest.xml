<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- QR okutma için gerekli. Ödül/logo seçiminde galeri kullanıldığı için
         fotoğraf çekme izni istenmiyor. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Android 13+ bildirim izni. Alt sürümlerde izin gerekmez. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Kamera zorunlu değil: kamerasız cihazlarda uygulama kurulabilir,
         yalnızca QR okutma devre dışı kalır. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- WhatsApp ile iletişim bağlantısının çözülebilmesi için (Android 11+ paket görünürlüğü) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".KumbaramApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kumbaram"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- QR tarayıcı ayrı activity: iOS'ta tam ekran modal olarak sunuluyor ve
             sekme değişimi olmuyor; Android'de aynı davranışı activity ile sağlıyoruz. -->
        <activity
            android:name=".ui.customer.qr.QrScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Kumbaram.QrScanner"
            tools:ignore="LockedOrientationActivity" />

        <service
            android:name=".service.KumbaramMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="kumbaram_campaigns" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/primary" />
    </application>

</manifest>
